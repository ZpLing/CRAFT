# ── Credentials & secrets ────────────────────────────────────────────
# Repo-root config.py holds the real API keys — never commit it
/config.py
*.env
.env*
secrets.*

# ── Run logs (may contain API keys / local paths) ─────────────────────
*.log

# ── Experiment data ───────────────────────────────────────────────────
# Part 1's results are the pilot study's evidence and are small enough to track
# (11 MB); Part 2's craft_runs are 3.2 GB and stay local.
/results/
Part2_CRAFT/results/*
# The baselines' runs are the evidence for the main table, so they are tracked:
# results.json is the data, traces.jsonl the generations behind it, which is what
# lets the table be re-scored without paying for the runs again.
!Part2_CRAFT/results/baseline_results/
# The analyses behind the appendix are small — kilobytes — and are what the
# appendix numbers are read from, so they are tracked too.
!Part2_CRAFT/results/CRAFT_results/
# Backups the eviction tool leaves behind are working files, not results.
*.bak
*.jsonl.bak
*.json.bak

# ── Dataset sources — the raw downloads the benchmark was built from ──
# dataset/label_prediction/ holds the benchmark itself, 500 curated samples
# per file. What they were cut from is large and stays local.
Part2_CRAFT/dataset/_source/

# ── Vendored third-party code (clone separately) ──────────────────────
/third_party/
Part1_Pilot Study/experiments/roscoe_experiment/ParlAI/
Part2_CRAFT/evaluation/reasoning_traces_quality/ROSCOE/ParlAI/

# ── Python cache ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Virtual environments ──────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Jupyter ───────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── OS artefacts ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Figures and the scripts that draw them — kept local, never pushed ─
# chart/ holds one script per experiment setting; figure/ is what they write.
# They need matplotlib, which the requirements deliberately leave out, and
# every figure is redrawn from results/ on demand.
/chart/
/figure/
/Figure/

# ── Paper source — kept locally, never pushed ─────────────────────────
/Paper/
/Reasoning_CoT_EMNLP*.zip
/paper/

# ── Baselines — kept locally, never pushed ───────────────────────────
/baselines/

# ── Filtering statistics — a local check, not part of the pipeline ───
Part2_CRAFT/evaluation/filtering_stats/
Part2_CRAFT/results/CRAFT_results/filtering_stats/

# ── Dropped baselines and pre-swap backups — kept locally, never pushed ──
Part2_CRAFT/results/baseline_results/_archive/
