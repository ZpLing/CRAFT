# ── Credentials & secrets ────────────────────────────────────────────
# Repo-root config.py holds the real API keys — never commit it
/config.py
*.env
.env*
secrets.*

# ── Run logs (may contain API keys / local paths) ─────────────────────
*.log

# ── Experiment data ───────────────────────────────────────────────────
# Part 1's results are the pilot study's evidence and are small enough to track
# (11 MB); Part 2's craft_runs are 3.2 GB and stay local.
/results/
Part2_CRAFT/results/

# ── Vendored third-party code (clone separately) ──────────────────────
/third_party/
Part1_Pilot Study/experiments/roscoe_experiment/ParlAI/

# ── Python cache ─────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# ── Virtual environments ──────────────────────────────────────────────
.venv/
venv/
env/
ENV/

# ── Jupyter ───────────────────────────────────────────────────────────
.ipynb_checkpoints/
*.ipynb

# ── OS artefacts ─────────────────────────────────────────────────────
.DS_Store
Thumbs.db

# ── Generated figures — regenerated from results, never pushed ───────
# chart/ is what the scripts draw into, plot/ is the scripts themselves: they
# need matplotlib, which the requirements deliberately leave out, and they
# redraw from results/ on demand.
/chart/
/plot/

